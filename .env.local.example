# Copy this file to .env.local and fill in your key.
# .env.local is gitignored and is NEVER shipped to the browser.
# Do NOT prefix this with NEXT_PUBLIC_ — that would expose it to the client.

OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown)
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Off-topic guardrail: questions whose best retrieval score is below this get a
# canned reply instead of an LLM call (saves tokens). Raise to be stricter,
# lower to answer more loosely-related questions. Default 0.2.
# RAG_MIN_SCORE=0.2

# Optional — only for `npm run sync:github`. Not required for a handful of repos.
# GITHUB_USERNAME=shivang-jani
# GITHUB_TOKEN=ghp_...   # raises the GitHub API rate limit if you ever hit it
